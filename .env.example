# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Find these in your Supabase Project Settings -> API
# https://supabase.com/dashboard/project/_/settings/api

# Public URL of your Supabase project (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key (safe for client-side, protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Secret (SERVER ONLY - NEVER EXPOSE TO CLIENT / BROWSER)
# Used for backend jobs, admin scripts, and webhook processing
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
